generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum AllergyRecordStatus {
  KNOWN
  NONE_KNOWN
  NOT_RECORDED
}

enum EncounterStatus {
  DRAFT
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum OrderType {
  MEDICATION
  LAB
}

enum OrderStatus {
  DRAFT
  ORDERED
}

model DemoSession {
  id           String        @id @default(cuid())
  sessionKey   String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  patients     Patient[]
  appointments Appointment[]
  encounters   Encounter[]
}

model Patient {
  id                 String              @id @default(cuid())
  demoSessionId      String
  medicalRecordNumber String             @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  sex                String?
  email              String?
  phone              String?
  emergencyName      String?
  emergencyPhone     String?
  status             PatientStatus       @default(ACTIVE)
  allergyStatus      AllergyRecordStatus @default(NOT_RECORDED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  demoSession        DemoSession          @relation(fields: [demoSessionId], references: [id], onDelete: Cascade)
  allergies          Allergy[]
  conditions         Condition[]
  medications        Medication[]
  appointments       Appointment[]
  encounters         Encounter[]

  @@index([demoSessionId, lastName, firstName])
  @@index([demoSessionId, status])
}

model Allergy {
  id        String  @id @default(cuid())
  patientId String
  name      String
  reaction  String?
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Condition {
  id        String  @id @default(cuid())
  patientId String
  name      String
  status    String  @default("Active")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Medication {
  id        String  @id @default(cuid())
  patientId String
  name      String
  details   String?
  status    String  @default("Current")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Appointment {
  id            String            @id @default(cuid())
  demoSessionId String
  patientId     String
  startsAt      DateTime
  visitReason   String
  status        AppointmentStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  demoSession   DemoSession       @relation(fields: [demoSessionId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter     Encounter?

  @@index([demoSessionId, startsAt])
  @@index([patientId, startsAt])
}

model Encounter {
  id              String          @id @default(cuid())
  demoSessionId   String
  patientId       String
  appointmentId   String?         @unique
  status          EncounterStatus @default(DRAFT)
  revision        Int             @default(0)
  visitReason     String          @default("")
  bloodPressure   String?
  heartRate       Float?
  temperature     Float?
  respiratoryRate Float?
  oxygenSaturation Float?
  weight          Float?
  height          Float?
  subjective      String          @default("")
  objective       String          @default("")
  assessment      String          @default("")
  plan            String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?
  demoSession     DemoSession     @relation(fields: [demoSessionId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  orders          EncounterOrder[]

  @@index([demoSessionId, status])
  @@index([patientId, createdAt])
}

model EncounterOrder {
  id           String      @id @default(cuid())
  encounterId  String
  type         OrderType
  catalogKey   String
  itemName     String
  instructions String?
  status       OrderStatus @default(DRAFT)
  encounter    Encounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}
