{
  "name": "carechart-emr-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "cross-env RUST_LOG=info prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "test:prepare": "cross-env DATABASE_URL=file:./test.db RUST_LOG=info prisma db push --force-reset --skip-generate && cross-env DATABASE_URL=file:./test.db tsx prisma/seed.ts",
    "test": "npm run test:prepare && cross-env DATABASE_URL=file:./test.db vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run db:reset && npm run build && playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^27.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
